# ============================================================
# NetSage AI — Example environment variables
# ============================================================
# Copy this file to ".env" (which is git-ignored) and add your
# real values there. NEVER commit the real .env file.
#
#   COPY:         copy this file to ".env"
#   EDIT:         put your real key in .env only
#
# The API key is read at runtime from the environment variable
# OPENAI_API_KEY. It is never hard-coded in source code.
# ============================================================

# Your OpenAI API key (replace with your real key in .env)
OPENAI_API_KEY=

# Optional: model used by live mode.
# Leave blank to use the engine default (gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI API base URL.
# Only change if using a compatible third-party endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1